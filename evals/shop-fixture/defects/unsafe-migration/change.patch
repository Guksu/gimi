+/** 주문 메모 — 없으면 빈 문자열, 앞뒤 공백을 지우고 100자까지 */
+const parseMemo = (value: unknown) => {
+  if (value === undefined || value === null) return ''
+  if (typeof value !== 'string') throw fail(400, 'INVALID_MEMO', '메모는 문자열이다')
+  const memo = value.trim()
+  if (memo.length > 100) throw fail(400, 'MEMO_TOO_LONG', '메모는 100자까지 쓴다')
+  return memo
+}
