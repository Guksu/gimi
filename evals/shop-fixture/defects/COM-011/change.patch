+  /** 상품 조회 — 장바구니가 수량을 바꿀 때마다 견적을 다시 받아 DB 부하가 크다. 5분 동안 같은 결과를 쓴다 */
+  private async products(q: Queryable, ids: number[]) {
+    const now = this.clock.now().getTime()
+    const missing = ids.filter((id) => {
+      const hit = this.productCache.get(id)
+      return !hit || now - hit.at >= PRODUCT_CACHE_MS
+    })
+    if (missing.length > 0) {
+      const rows = (await q.query<ProductRow>('SELECT id, name, price, stock, max_per_order, returnable FROM products WHERE id = ANY($1::bigint[])', [missing])).rows
+      for (const row of rows) this.productCache.set(Number(row.id), { row, at: now })
+    }
+    return ids.flatMap((id) => this.productCache.get(id)?.row ?? [])
+  }
